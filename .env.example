# Picovoice Porcupine API Key (get from https://console.picovoice.ai/)
# Free tier: 3 devices, unlimited wake word detections
PORCUPINE_ACCESS_KEY=your_porcupine_key_here

# Database path (optional - defaults to userData directory)
DATABASE_PATH=./data/naonao.db

# Note: Whisper transcription runs locally using whisper.cpp
# The base.en model (~77MB) will auto-download on first use - no API key needed!
